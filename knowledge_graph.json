{
  "meta": {
    "name": "ABL / Kore.ai Value Model Knowledge Graph",
    "description": "A proof-of-concept knowledge graph of the concepts, benchmarks, and causal links behind the ABL contact-center value model. Built from scratch to demonstrate entity + relationship knowledge you can query and traverse.",
    "version": "0.1.0",
    "node_count": 24,
