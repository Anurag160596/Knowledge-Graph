    { "id": "pure_llm_rival", "type": "Competitor", "label": "Pure-LLM Rival", "props": { "cost_trend": "rising toward $3+/resolution by 2030" } },
    { "id": "moat", "type": "Thesis", "label": "The Cost-Divergence Moat", "props": { "claim": "ABL cost stays near infra floor while pure-LLM rivals climb" } },
    { "id": "seat_decay", "type": "Thesis", "label": "Seat-Decay Contradiction", "props": { "claim": "per-seat pricing loses revenue as automation succeeds" } },
    { "id": "consumption_pricing", "type": "Concept", "label": "Consumption / Outcome Pricing", "props": { "note": "preserves customer savings; ABL aligns here" } },

    { "id": "tier_low", "type": "ComplexityTier", "label": "Low Complexity Tier", "props": { "automation_rate": 0.90, "llm_calls": 0 } },
    { "id": "tier_med", "type": "ComplexityTier", "label": "Medium Complexity Tier", "props": { "automation_rate": 0.60, "llm_calls": 1, "in_tokens": 2000, "out_tokens": 500 } },
    { "id": "tier_high", "type": "ComplexityTier", "label": "High Complexity Tier", "props": { "automation_rate": 0.25, "llm_calls": 4, "in_tokens": 4000, "out_tokens": 1000 } },

    { "id": "platform_cost", "type": "Assumption", "label": "Platform Cost / Interaction", "props": { "value": 0.20, "unit": "USD", "note": "all-in deterministic floor" } },
    { "id": "token_price_in", "type": "Assumption", "label": "Input Token Price", "props": { "value": 3.00, "unit": "USD per 1M tokens" } },
    { "id": "token_price_out", "type": "Assumption", "label": "Output Token Price", "props": { "value": 15.00, "unit": "USD per 1M tokens" } },
    { "id": "human_cost", "type": "Assumption", "label": "Human Cost / Resolution", "props": { "value": 7.16, "unit": "USD", "source": "mckinsey" } },

    { "id": "effective_deflection", "type": "Concept", "label": "Effective Deflection", "props": { "formula": "automation_rate x (1 - failed_containment) x (1 - repeat_drag)" } },
    { "id": "failed_containment", "type": "Assumption", "label": "Failed Containment", "props": { "value": 0.12 } },
    { "id": "repeat_drag", "type": "Assumption", "label": "Repeat Drag", "props": { "value": 0.06 } },
    { "id": "tier_value", "type": "Metric", "label": "Tier Value", "props": { "formula": "automated_volume x (human_cost - abl_cost)" } },
    { "id": "seats_released", "type": "Metric", "label": "Seats Released", "props": { "formula": "total_value / cost_per_agent" } },
    { "id": "npv", "type": "Metric", "label": "3-Year NPV", "props": { "wacc": 0.12, "ramp": "Y1 40% / Y2 75% / Y3 100%" } },

    { "id": "gartner", "type": "Source", "label": "Gartner", "props": {} },
    { "id": "mckinsey", "type": "Source", "label": "McKinsey", "props": {} },
    { "id": "forrester", "type": "Source", "label": "Forrester TEI", "props": { "roi": "208-391%", "payback_months": 5.4 } },
    { "id": "reference_case", "type": "Scenario", "label": "Reference Case", "props": { "interactions": 100000000, "agents": 20000, "cost_per_agent": 45000 } }
